; npt.mdp — 1 ns NPT equilibration at 310 K / 1 bar, position restraints
; ITrace reproduction protocol · GROMACS + CHARMM36 (Jul 2021) / TIP3P
define          = -DPOSRES
integrator      = md
dt              = 0.002          ; 2 fs
nsteps          = 500000         ; 1 ns

; output
nstxout-compressed = 5000
nstlog          = 5000
nstenergy       = 5000

; bonds / constraints (continue from NVT)
continuation         = yes
constraint_algorithm = lincs
constraints          = h-bonds
lincs_order          = 4

; neighbour searching
cutoff-scheme   = Verlet
nstlist         = 40
pbc             = xyz
rlist           = 1.2

; electrostatics + van der Waals (CHARMM36)
coulombtype     = PME
rcoulomb        = 1.2
fourierspacing  = 0.16
pme_order       = 4
vdwtype         = cutoff
vdw-modifier    = force-switch
rvdw-switch     = 1.0
rvdw            = 1.2

; temperature coupling — solute / solvent separate
tcoupl          = V-rescale
tc-grps         = Protein  Non-Protein
tau_t           = 0.2      0.2
ref_t           = 310      310

; pressure coupling
pcoupl          = C-rescale
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = 1.0
compressibility = 4.5e-5         ; bar^-1

gen_vel         = no
